@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Spremeni geslo";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;

    ViewData["BodyClass"] = "auth-background";
    Layout = "/Views/Shared/_Layout.cshtml";   // <-- KLJUČNO (ne uporabi Manage layouta)
}


<div class="auth-page">
    <div class="auth-card">
        <h1 class="auth-title">SPREMENI GESLO</h1>

        <partial name="_StatusMessage" for="StatusMessage" />

        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-custom mb-3">
                <input asp-for="Input.OldPassword"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Staro geslo..." />
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-custom mb-3">
                <input asp-for="Input.NewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Novo geslo..." />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-custom mb-3">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Ponovi novo geslo..." />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth w-100">Posodobi geslo</button>

            <p class="already mt-3">
                <a asp-page="../Index">Nazaj na profil</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
