@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Pozabljeno geslo";
    ViewData["BodyClass"] = "auth-background";
}

<div class="auth-page">
    <div class="auth-card">
        <h1 class="auth-title">POZABLJENO GESLO</h1>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-custom mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="E-mail..." />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth w-100">Pošlji povezavo</button>

            <p class="already mt-3">
                <a asp-page="./Login">Nazaj na prijavo</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
