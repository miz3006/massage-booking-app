@page
@model RegisterModel
@{
    ViewData["Title"] = "Ustvari nov račun";
    ViewData["BodyClass"] = "auth-background"; 
}


<div class="register-page">
    <div class="register-card">
        <h1 class="register-title">USTVARI NOV RAČUN</h1>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-custom mb-3">
                        <input asp-for="Input.FirstName" class="form-control" placeholder="Ime..." />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-custom mb-3">
                        <input asp-for="Input.LastName" class="form-control" placeholder="Priimek..." />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-custom mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="E-mail..." />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-custom mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="GSM..." />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-custom mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Geslo..." />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-custom mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Potrdi geslo..." />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-check mb-4 pogoji_uporabe">
                <input class="form-check-input" type="checkbox" id="terms" />
                <label class="form-check-label" for="terms">
                    Strinjam se s pogoji uporabe
                </label>
            </div>

            <button id="registerSubmit" type="submit" class="btn-register w-100" disabled>
                Ustvarite nov račun
            </button>


            <p class="already mt-4">
                Imate že ustvarjen profil?
                <a asp-page="./Login">Prijavi se</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const terms = document.getElementById('terms');
        const registerBtn = document.getElementById('registerSubmit');

        terms.addEventListener('change', () => {
            registerBtn.disabled = !terms.checked;
        });
    </script>
}

