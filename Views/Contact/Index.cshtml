@{
    ViewData["Title"] = "Kontakt";
}

<h1>Kontakt</h1>

<p>Če nas želiš kontaktirati, uporabi spodnje informacije:</p>

<div class="card p-3 mt-3">
    <h4>Masažni studio</h4>
    <p>
        📍 Naslov: Ljubljana, Center 12<br />
        ☎ Telefon: +386 41 123 456<br />
        ✉ Email: info@masazestudio.si
    </p>
</div>

<div class="mt-4">
    <h4>Pošlji nam sporočilo</h4>

    <form>
        <div class="mb-3">
            <label class="form-label">Ime</label>
            <input type="text" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Sporočilo</label>
            <textarea class="form-control" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Pošlji</button>
    </form>
</div>
