@{
    ViewData["Title"] = "O nas";
    ViewData["BodyClass"] = "subpage about-page";
}

<div class="subpage-hero">
    <div class="subpage-hero-inner">
        <span class="subpage-hero-kicker">NAŠA ZGODBA</span>
        <h1>O NAS</h1>
        <p class="subpage-hero-sub">Digitaliziramo svet sproščanja v osrčju Ljubljane</p>
    </div>
</div>

<section class="about-mission-section">
    <div class="about-section-container">
        <div class="about-split">
            <div class="about-copy">
                <span class="about-kicker">NAŠA MISIJA</span>
                <h2 class="about-section-title">Hiter, enostaven in zanesljiv način rezervacije</h2>
                <p>
                    Naša spletna aplikacija za rezervacijo azijskih masaž je zasnovana z mislijo na sodoben tempo življenja,
                    kjer uporabniki potrebujejo hiter, enostaven in zanesljiv način za organizacijo svojega časa.
                </p>
                <p>
                    Sistem omogoča preprost pregled nad prostimi termini, izbiro vrste masaže, izvajalca ter rezervacijo
                    v le nekaj klikih – brez telefonskega klica ali obiska salona.
                </p>
                <div class="about-features">
                    <div class="about-feature-item">
                        <span class="about-feat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span>Rezervacija v le nekaj klikih</span>
                    </div>
                    <div class="about-feature-item">
                        <span class="about-feat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span>Realnočasovno upravljanje terminov</span>
                    </div>
                    <div class="about-feature-item">
                        <span class="about-feat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span>Brez dvojnih rezervacij</span>
                    </div>
                    <div class="about-feature-item">
                        <span class="about-feat-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span>Potrditev rezervacije po e-pošti</span>
                    </div>
                </div>
            </div>

            <div class="about-visual">
                <div class="about-image"
                     style="background-image:url('https://images.unsplash.com/photo-1544161515-4ab6ce6db874?q=80&w=2070&auto=format&fit=crop')">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="about-values-section">
    <div class="about-section-container">
        <div class="about-values-header">
            <span class="about-kicker">ZAKAJ MI?</span>
            <h2 class="about-section-title">Prednosti naše platforme</h2>
        </div>
        <div class="about-values-grid">
            <div class="about-value-card">
                <div class="about-value-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <h3>Prihranek časa</h3>
                <p>Rezervirajte termin v manj kot minuti, kadar koli in kjer koli. Brez čakanja na odziv salona.</p>
            </div>
            <div class="about-value-card">
                <div class="about-value-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h3>Zanesljivost</h3>
                <p>Sistem v realnem času prepreči dvojne rezervacije in zagotovi natančen pregled zasedenosti.</p>
            </div>
            <div class="about-value-card">
                <div class="about-value-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                </div>
                <h3>Dostopnost</h3>
                <p>Dostopno na vseh napravah – telefon, tablica, računalnik. Rezervirajte kjerkoli ste.</p>
            </div>
            <div class="about-value-card">
                <div class="about-value-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <h3>Osebni profil</h3>
                <p>Pregled preteklih rezervacij in upravljanje vašega profila na enem mestu.</p>
            </div>
        </div>
    </div>
</section>

<section class="about-team-section">
    <div class="about-section-container">
        <div class="about-team-header">
            <span class="about-kicker">EKIPA</span>
            <h2 class="about-section-title">Razvijalca projekta</h2>
            <p class="about-team-sub">Projekt razvijata študenta Univerze v Ljubljani</p>
        </div>
        <div class="about-team-grid">
            <div class="about-team-card">
                <div class="about-team-avatar">EM</div>
                <h3>Edis Mizić</h3>
                <p>Vpisna številka: 63240212</p>
                <span class="about-team-role">Full-stack razvijalec</span>
            </div>
            <div class="about-team-card">
                <div class="about-team-avatar">AA</div>
                <h3>Aleks Ašanin</h3>
                <p>Vpisna številka: 63240010</p>
                <span class="about-team-role">Full-stack razvijalec</span>
            </div>
        </div>
    </div>
</section>

<section class="about-cta-section">
    <div class="about-section-container">
        <div class="about-cta-box">
            <div class="about-cta-copy">
                <h2>Pripravite se na popolno sprostitev</h2>
                <p>Rezervirajte svojo masažo danes in odkrijte svet azijskega zdravilstva.</p>
            </div>
            <div class="about-cta-actions">
                <a asp-controller="Massages" asp-action="Index" class="btn-main">REZERVIRAJ TERMIN</a>
                <a asp-controller="Contact" asp-action="Index" class="about-cta-link">Kontaktirajte nas →</a>
            </div>
        </div>
    </div>
</section>
