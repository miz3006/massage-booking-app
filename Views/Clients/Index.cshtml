@using MassageStudio.Models
@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Seznam strank";
}

<h2>Seznam strank</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ime</th>
            <th>Priimek</th>
            <th>Email</th>
            <th>Telefon</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var client in Model)
    {
        <tr>
            <td>@client.FirstName</td>
            <td>@client.LastName</td>
            <td>@client.Email</td>
            <td>@client.PhoneNumber</td>  @* ali @client.Phone če imaš alias *@
        </tr>
    }
    </tbody>
</table>
