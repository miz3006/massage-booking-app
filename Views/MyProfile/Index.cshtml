@model MassageStudio.Models.ApplicationUser

@{
    ViewData["Title"] = "Moj račun";
    ViewData["BodyClass"] = "subpage profile-page-body";
}

<div class="subpage-hero">
    <h1>MOJ PROFIL</h1>
</div>

<div class="subpage-content profile-page">
    <div class="profile-container">

        <div class="card profile-card">
            <div class="profile-header">
                <div class="profile-avatar">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>

                <h3>@Model.FirstName @Model.LastName</h3>

                <span class="profile-role">
                    @(User.IsInRole("Admin") ? "Admin" : "Stranka")
                </span>
            </div>

            <div class="profile-details">
                <div class="profile-row">
                    <strong>Ime</strong>
                    <span>@Model.FirstName</span>
                </div>
                <div class="profile-row">
                    <strong>Priimek</strong>
                    <span>@Model.LastName</span>
                </div>
                <div class="profile-row">
                    <strong>Email naslov</strong>
                    <span>@Model.Email</span>
                </div>
                <div class="profile-row">
                    <strong>Telefonska številka</strong>
                    <span>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "/" : Model.PhoneNumber)</span>
                </div>
            </div>
        </div>

        <div class="profile-actions">

            @* ADMIN toggle gumb *@
            @if (User.IsInRole("Admin"))
            {
                var adminMode = Context.Request.Cookies["admin_mode"] == "1";

                if (!adminMode)
                {
                    <form asp-controller="MyProfile" asp-action="EnableAdminMode" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-action-outline">
                            Admin dashboard
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="MyProfile" asp-action="DisableAdminMode" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-action-outline">
                            Navadna stran
                        </button>
                    </form>
                }
            }

            <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn-action-outline">
                Spremeni geslo
            </a>

            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-action-danger">Odjava iz računa</button>
            </form>
        </div>

    </div>
</div>
