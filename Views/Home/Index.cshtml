@{
    ViewData["Title"] = "Domov"; 
    ViewData["BodyClass"] = "home-page"; 
}


<div class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content hero-container">
        <h1 class="hero-title">CENTER AZIJSKIH MASAŽ</h1>
        <p class="hero-subtitle">
            Odmisilte skrbi, umirite telo in misli ter si privoščite popolno sprostitev
            na eni izmed mnogih masaž iz naše ponudbe.
        </p>

        <a asp-controller="Services" asp-action="Index" class="btn-main">
            REZERVIRAJTE TERMIN
        </a>
    </div>
</div>

<section id="statistika" class="section">
    <div class="hero-container">
        <h2>Statistika sistema</h2>

        <div class="alert alert-info">
            Število masaž v sistemu: <strong>@ViewBag.ServicesCount</strong>
        </div>
        <div class="alert alert-success">
            Število strank v sistemu: <strong>@ViewBag.ClientsCount</strong>
        </div>

        <p class="mt-3">
            <a class="btn btn-primary" asp-controller="Massages" asp-action="Index">Poglej masaže</a>
            <a class="btn btn-secondary" asp-controller="Clients" asp-action="Index">Poglej stranke</a>
             <a class="btn btn-secondary" asp-controller="Massages" asp-action="Create">Dodej masaže</a>
        </p>
    </div>
</section>
