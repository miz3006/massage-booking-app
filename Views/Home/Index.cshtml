@{
    ViewData["Title"] = "Home";
}

<h1>Dobrodošli v MassageStudio</h1>

<div class="alert alert-info">
    Število masaž v sistemu: <strong>@ViewBag.ServicesCount</strong>
</div>
<div class="alert alert-success">
    Število strank v sistemu: <strong>@ViewBag.ClientsCount</strong>
</div>

<p class="mt-3">
    <a class="btn btn-primary" asp-controller="Services" asp-action="Index">Poglej masaže</a>
    <a class="btn btn-secondary" asp-controller="Clients" asp-action="Index">Poglej stranke</a>
</p>

