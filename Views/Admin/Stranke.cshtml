@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Uporabniki";
    ViewData["BodyClass"] = "subpage admin-page";
}

@* Hero sekcija s prosojnim napisom *@
<div class="subpage-hero">
    <div class="container">
        <h1>UPORABNIKI</h1>
    </div>
</div>

<div class="admin-wrap">
    <div class="admin-card">
        <div class="admin-card__head">
            <div>
                <h2>Seznam strank</h2>
                <p>Pregled registriranih uporabnikov v vašem sistemu.</p>
            </div>
            
            @* Statistika vključena diskretno v glavo *@
            <div class="admin-stats-pill">
                Število strank: <strong>@ViewBag.ClientsCount</strong>
            </div>
        </div>

        <div class="admin-table-wrap">
            @* ... (hero in glava ostajata ista) ... *@

            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: auto;">Ime in priimek</th>
                        <th style="width: 250px;">E-naslov</th>
                        <th style="width: 180px;">Telefon</th>
                        <th style="width: 180px;" class="text-end">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><strong>@u.FirstName @u.LastName</strong></td>
                        <td><span class="admin-muted">@u.Email</span></td>
                        <td><span class="code-plain">@u.PhoneNumber</span></td>
                        <td class="text-end">
                            <div class="admin-actions justify-content-end">
                                @* GUMB ZA UREJANJE *@
                                <a asp-action="UrediUporabnika" asp-route-id="@u.Id" class="admin-btn admin-btn--ghost admin-btn--sm">
                                    Uredi
                                </a>

                                @if (u.Email != "admin@gmail.com")
                                {
                                    <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Izbrišem uporabnika?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">
                                            Izbriši
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>