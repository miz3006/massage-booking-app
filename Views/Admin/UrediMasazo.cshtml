@model MassageStudio.Models.Masaza

@{
    ViewData["Title"] = "Uredi masažo";
    ViewData["BodyClass"] = "subpage admin-page";
}

<div class="subpage-hero">
    <div class="container">
        <h1>UREDI MASAŽO</h1>
    </div>
</div>

<div class="admin-wrap">
    <div class="admin-card">
        <div class="admin-card__head">
            <div>
                <h2>Uredi storitev</h2>
                <p>Posodobi podatke masaže in shrani spremembe.</p>
            </div>
        </div>

        <div class="admin-card__body">
            <form asp-action="UrediMasazo" method="post" class="admin-form-modern">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IdMasaze" />

                <div class="admin-form-grid">
                    <div class="form-group full-width">
                        <label class="admin-label-small">NAZIV MASAŽE</label>
                        <input asp-for="NazivMasaze" class="admin-input-field" />
                        <span asp-validation-for="NazivMasaze" class="text-danger"></span>
                    </div>

                    <div class="form-group full-width">
                        <label class="admin-label-small">OPIS STORITVE</label>
                        <textarea asp-for="Opis" rows="4" class="admin-input-field"></textarea>
                        <span asp-validation-for="Opis" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="admin-label-small">TRAJANJE (MIN)</label>
                        <input asp-for="TrajanjeMasaze" type="number" class="admin-input-field" />
                        <span asp-validation-for="TrajanjeMasaze" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="admin-label-small">CENA (€)</label>
                        <input asp-for="Cena" type="number" step="0.01" class="admin-input-field" />
                        <span asp-validation-for="Cena" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="admin-label-small">VRSTA</label>
                        <input asp-for="Vrsta" class="admin-input-field" />
                        <span asp-validation-for="Vrsta" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="admin-label-small">KRATICA</label>
                        <input asp-for="Kratica" class="admin-input-field" />
                        <span asp-validation-for="Kratica" class="text-danger"></span>
                    </div>
                </div>

                <div class="admin-form-footer">
                    <a asp-action="Masaze" class="admin-btn admin-btn--ghost">Nazaj</a>
                    <button type="submit" class="admin-btn admin-btn--primary">Shrani spremembe</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
