<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MassageStudio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap + CSS ALWAYS FIRST -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body class="@ViewData["BodyClass"]">


    <header class="hero-nav">
        <div class="hero-container hero-nav-inner">
            <div class="logo">MassageStudio</div>

            <nav class="nav-links">
                @if (User.IsInRole("Admin"))
                {
                    <!-- Admin meni -->
                    <a asp-controller="Admin" asp-action="Maserji">Osebje</a>
                    <a asp-controller="Admin" asp-action="Termini">Upravljanje terminov</a>
                    <a asp-controller="Admin" asp-action="Masaze">Upravljanje masaž</a>
                    <a asp-controller="Admin" asp-action="Rezervacije">Rezervacije</a>
                    <a asp-controller="Admin" asp-action="Stranke">Stranke</a>
                    <a asp-controller="Admin" asp-action="Obvestila">Obvestila</a>
                }
                else
                {
                    <!-- Navadni uporabnik meni -->
                    <a asp-controller="Home" asp-action="Index">Domov</a>
                    <a asp-controller="AboutUs" asp-action="Index">O nas</a>
                    <a asp-controller="Massages" asp-action="Index">Masaže</a>
                    <a asp-controller="Maser" asp-action="Index">Osebje</a>
                    <a asp-controller="Contact" asp-action="Index">Kontakt</a>
                }
            </nav>

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-controller="MyProfile" asp-action="Index" class="btn-pill">
                    Moj profil
                </a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn-pill">
                    Prijava v profil
                </a>
            }
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MassageStudio
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
